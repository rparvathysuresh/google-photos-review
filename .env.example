# ──────────────────────────────────────────────
# Environment Configuration
# AI-Powered Photo Retrieval Discovery Engine
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Required variables are marked with [REQUIRED].
# ──────────────────────────────────────────────

# ── LLM (Groq) ───────────────────────────────
# [REQUIRED] API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Model ID for extraction and RAG (default: llama-3.1-70b-versatile)
# GROQ_MODEL=llama-3.1-70b-versatile

# ── Database ──────────────────────────────────
# SQLAlchemy connection URL (default: SQLite local file)
# DATABASE_URL=sqlite:///data/discovery.db

# ── Vector Store ──────────────────────────────
# Directory for ChromaDB persistent storage
# CHROMA_PERSIST_DIR=data/chroma

# ── Embedding Model ──────────────────────────
# HuggingFace model ID for BGE embeddings
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_BATCH_SIZE=64

# ── Reddit API (Optional) ────────────────────
# Get credentials at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USER_AGENT=DiscoveryEngine/1.0

# ── YouTube API (Optional) ───────────────────
# Get API key at https://console.cloud.google.com/
# YOUTUBE_API_KEY=your_youtube_api_key

# ── Play Store (Optional) ────────────────────
# Language for Play Store reviews
# PLAYSTORE_LANG=en

# ── Server ────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG=true
